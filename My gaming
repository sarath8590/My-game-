
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Eeswaran vs Inba – Chennai Chase</title>

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
:root {
  box-sizing: border-box;
  color-scheme: dark;
  --bg: #14040a;
  --btn: rgba(255,200,60,.28);
  --edge: #ffcf3a;
}

html, body {
  height: 100%;
  margin: 0;
  background: var(--bg);
  overflow: hidden;
  touch-action: none;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
}

body {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: env(safe-area-inset-top,0px);
}

canvas {
  width: 100vw;
  max-height: 100vh;
  aspect-ratio: 16 / 9;
  image-rendering: pixelated;
  background: rgb(255,34,0);
  display: block;
}

@media (min-aspect-ratio: 16 / 9) {
  canvas {
    width: auto;
    height: 100vh;
  }
}

.c {
  position: fixed;
  bottom: calc(14px + env(safe-area-inset-bottom,0px));
  width: var(--bs,76px);
  height: var(--bs,76px);
  opacity: var(--bo,.4);
  border-radius: 50%;
  border: 4px solid var(--edge);
  background: var(--btn);
  color: white;
  font: 700 10px "Press Start 2P", monospace;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  z-index: 5;
  backdrop-filter: blur(2px);
}

.c:active, .c.on {
  background: rgba(255,200,60,.65);
}

#sl { left: 18px; }
#jp { right: 18px; }

#gear {
  position: fixed;
  left: calc(10px + env(safe-area-inset-left,0px));
  top: calc(8px + env(safe-area-inset-top,0px));
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid var(--edge);
  background: rgba(0,0,0,.4);
  color: white;
  font-size: 18px;
  opacity: .6;
  z-index: 6;
  padding: 0;
}

#set {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(10,0,10,.7);
  z-index: 9;
  font: 12px "Press Start 2P", monospace;
  color: white;
}

#set.show { display: flex; }

#set div {
  background: rgb(42,10,20);
  border: 4px solid var(--edge);
  padding: 18px;
  width: min(86vw,360px);
  line-height: 2.2;
}

#set input { width: 100%; }

#set button {
  margin-top: 10px;
  font: inherit;
  padding: 10px 16px;
  background: rgb(193,18,31);
  color: white;
  border: 3px solid var(--edge);
}
</style>
</head>

<body>

<canvas id="cv" width="960" height="540"></canvas>

<div class="c" id="sl">SLIDE</div>
<div class="c" id="jp">JUMP</div>

<button id="gear" aria-label="Control settings">⚙</button>

<div id="set">
  <div>
    CONTROLS<br>
    Size
    <input id="rs" type="range" min="50" max="130" value="76"><br>
    Opacity
    <input id="ro" type="range" min="15" max="90" value="40"><br>
    Music
    <input id="rm" type="range" min="0" max="100" value="60"><br>
    Effects
    <input id="re" type="range" min="0" max="100" value="50"><br>
    <button id="rc">DONE</button>
  </div>
</div>

<script>
const gear = document.getElementById("gear");
const settings = document.getElementById("set");
const done = document.getElementById("rc");

gear.addEventListener("click", () => {
  settings.classList.add("show");
});

done.addEventListener("click", () => {
  settings.classList.remove("show");
});

document.getElementById("rs").addEventListener("input", e => {
  document.documentElement.style.setProperty("--bs", e.target.value + "px");
});

document.getElementById("ro").addEventListener("input", e => {
  document.documentElement.style.setProperty("--bo", e.target.value / 100);
});
</script>

</body>
</html>
